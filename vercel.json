{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm ci && python backend/manage.py collectstatic --noinput",
  "functions": {
    "api/index.py": {
      "includeFiles": "backend/staticfiles/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
